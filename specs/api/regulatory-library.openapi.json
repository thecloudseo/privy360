{
  "openapi": "3.1.0",
  "info": { "title": "Privy360 Regulatory Library", "version": "1.0.0" },
  "paths": {
    "/regulations": {
      "get": {
        "operationId": "listRegulations",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": { "type": "string", "maxLength": 2048 }
          },
          {
            "name": "query",
            "in": "query",
            "schema": { "type": "string", "maxLength": 200 }
          }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/RegulationPage" },
          "400": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/regulations/{regulationId}": {
      "get": {
        "operationId": "getRegulation",
        "parameters": [{ "$ref": "#/components/parameters/RegulationId" }],
        "responses": {
          "200": { "$ref": "#/components/responses/Regulation" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/requirements/{requirementId}/versions": {
      "get": {
        "operationId": "listRequirementVersions",
        "parameters": [{ "$ref": "#/components/parameters/RequirementId" }],
        "responses": {
          "200": { "$ref": "#/components/responses/RequirementVersions" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/provisions/{provisionId}": {
      "get": {
        "operationId": "getProvision",
        "parameters": [
          {
            "name": "provisionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"
            }
          }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Provision" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "RegulationId": {
        "name": "regulationId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"
        }
      },
      "RequirementId": {
        "name": "requirementId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"
        }
      }
    },
    "responses": {
      "Error": {
        "description": "Non-disclosing correlated error",
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/ApiError" }
          }
        }
      },
      "RegulationPage": {
        "description": "Published regulations only",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/RegulationPage" }
          }
        }
      },
      "Regulation": {
        "description": "Published regulation and immutable versions",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/RegulationSummary" }
          }
        }
      },
      "RequirementVersions": {
        "description": "Published requirement versions only",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/RequirementVersions" }
          }
        }
      },
      "Provision": {
        "description": "Published provision and citations",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["provision", "versions", "citations"]
            }
          }
        }
      }
    },
    "schemas": {
      "ApiError": {
        "type": "object",
        "required": ["type", "title", "status", "code", "correlationId"],
        "properties": {
          "type": { "const": "about:blank" },
          "title": { "type": "string" },
          "status": { "type": "integer" },
          "code": { "type": "string" },
          "correlationId": { "type": "string", "format": "uuid" }
        }
      },
      "RegulationPage": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/RegulationSummary" }
          },
          "nextCursor": { "type": "string" }
        }
      },
      "RegulationSummary": {
        "type": "object",
        "required": ["regulation", "versions"],
        "properties": {
          "regulation": { "type": "object" },
          "versions": { "type": "array", "items": { "type": "object" } }
        }
      },
      "RequirementVersions": {
        "type": "object",
        "required": ["requirement", "versions", "citations"],
        "properties": {
          "requirement": { "type": "object" },
          "versions": { "type": "array", "items": { "type": "object" } },
          "citations": { "type": "array", "items": { "type": "object" } }
        }
      }
    }
  }
}
